generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
}

model Payment {
  id String @id @default(cuid())

  amount  Float
  concept String?

  status PaymentStatus @default(PENDING)

  dueDate DateTime
  paidAt  DateTime?

  whatsappReminderSent    Boolean   @default(false)
  whatsappReminderSentAt  DateTime?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  budgetId String?
  budget   Budget? @relation(fields: [budgetId], references: [id])

  createdAt DateTime @default(now())
}

model User {
  id String @id @default(cuid())

  name     String
  email    String  @unique
  password String?
  image    String?

  role Role

  doctor  Doctor?
  patient Patient?

  lastLoginAt DateTime?
}

model Branch {
  id String @id @default(cuid())

  name    String
  city    String
  address String

  phone  String?
  mapUrl String?

  mondayToFridayHours String?
  saturdayHours       String?
  sundayHours         String?

  active Boolean @default(true)

  doctors        DoctorBranch[]
  patients       Patient[]
  appointments   Appointment[]
  galleryImages  GalleryImage[]
  availabilities DoctorAvailability[]
  expenses       Expense[]
}

model Doctor {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  specialty   String?
  description String?
  photo       String?

  active Boolean @default(true)

  branches       DoctorBranch[]
  patients       Patient[]
  appointments   Appointment[]
  budgets        Budget[]
  availabilities DoctorAvailability[]
}

model DoctorBranch {
  doctorId String
  branchId String

  doctor Doctor @relation(fields: [doctorId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([doctorId, branchId])
}

model Plan {
  id String @id @default(cuid())

  name        String
  description String
  price       Float?

  discount Float   @default(0)
  active   Boolean @default(true)

  patients Patient[]
}

model Patient {
  id String @id @default(cuid())

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  firstName String
  lastName  String

  dni   String?
  phone String
  email String?

  birthDate DateTime?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  appointments Appointment[]
  budgets      Budget[]
  histories    ClinicalHistory[]
  payments     Payment[]

  createdAt  DateTime    @default(now())
  odontogram Odontogram?
}

model Appointment {
  id String @id @default(cuid())

  date DateTime

  status AppointmentStatus @default(PENDING)
  reminderSent Boolean @default(false)

  notes String?

  patientId String
  doctorId  String
  branchId  String

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
}

model Budget {
  id String @id @default(cuid())

  description String?

  patientId String
  doctorId  String
  subtotal  Decimal
  discount  Decimal  @default(0)
  total     Decimal
  status    String   @default("DRAFT")

  patient  Patient      @relation(fields: [patientId], references: [id])
  doctor   Doctor       @relation(fields: [doctorId], references: [id])
  payments Payment[]
  items    BudgetItem[]

  createdAt DateTime @default(now())
}

model ClinicalHistory {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  diagnosis String?
  treatment String?

  data Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id Int @id @default(1)

  clinicName            String
  heroTitle             String
  heroSubtitle          String
  businessHoursWeek     String?
  businessHoursSaturday String?
  businessHoursSunday   String?

  logo      String?
  heroImage String?

  whatsapp  String?
  instagram String?
  facebook  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id String @id @default(cuid())

  title       String
  description String
  image       String?

  active Boolean @default(true)
}

model GalleryImage {
  id String @id @default(cuid())

  imageUrl String

  branchId String?

  branch Branch? @relation(fields: [branchId], references: [id])
}

model BudgetItem {
  id String @id @default(cuid())

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id])

  serviceName String

  quantity Int @default(1)

  unitPrice Float

  total Float
}

model Odontogram {
  id String @id @default(cuid())

  patientId String @unique

  patient Patient @relation(fields: [patientId], references: [id])

  data Json

  updatedAt DateTime @updatedAt
}

model OdontogramCondition {
  id String @id @default(cuid())

  name  String
  color String

  createdAt DateTime @default(now())
}

model DoctorAvailability {
  id String @id @default(cuid())

  doctorId String
  branchId String

  date      DateTime
  startTime String
  endTime   String

  doctor Doctor @relation(fields: [doctorId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  concept   String
  category  String
  amount    Float
  date      DateTime

  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
}

model Treatment {
  id String @id @default(cuid())

  name        String
  description String?
  price       Float?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
}