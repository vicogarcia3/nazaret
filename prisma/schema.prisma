generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id                     String        @id @default(cuid())
  amount                 Decimal       @db.Decimal(12, 2)
  concept                String?
  status                 PaymentStatus @default(PENDING)
  dueDate                DateTime
  paidAt                 DateTime?
  patientId              String
  budgetId               String?
  createdAt              DateTime      @default(now())
  whatsappReminderSent   Boolean       @default(false)
  whatsappReminderSentAt DateTime?
  paymentMethod          String?

  // Comprobante generado al registrar el pago
  receiptNumber   String?   @unique
  receiptIssuedAt DateTime?
  receiptData     Json?

  // Registro de entrega al paciente
  receiptNotifiedAt DateTime?
  receiptEmailedAt  DateTime?

  budget  Budget? @relation(fields: [budgetId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([budgetId])
  @@index([status])
  @@index([paidAt])
  @@index([receiptIssuedAt])
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  password                String?
  role                    Role
  lastLoginAt             DateTime?
  image                   String?
  emailVerified           DateTime?
  doctor                  Doctor?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  patient                 Patient?
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Branch {
  id                  String                    @id @default(cuid())
  name                String
  city                String
  address             String
  phone               String?
  active              Boolean                   @default(true)
  mapUrl              String?
  mondayToFridayHours String?
  saturdayHours       String?
  sundayHours         String?
  appointments        Appointment[]
  doctors             DoctorBranch[]
  doctorSchedules     DoctorSchedule[]
  scheduleExceptions  DoctorScheduleException[]
  specificSchedules   DoctorSpecificSchedule[]
  expenses            Expense[]
  galleryImages       GalleryImage[]
  patients            Patient[]
}

model Doctor {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  specialty           String?
  description         String?
  photo               String?
  professionalLicense String?
  email               String?
  phone               String?
  birthDate           DateTime?
  dni                 String?
  active              Boolean   @default(true)
  name                String
  visible             Boolean   @default(true)

  appointments                Appointment[]
  budgets                     BudgetDoctor[]
  user                        User?                       @relation(fields: [userId], references: [id])
  branches                    DoctorBranch[]
  schedules                   DoctorSchedule[]
  scheduleExceptions          DoctorScheduleException[]
  specificSchedules           DoctorSpecificSchedule[]
  notifications               Notification[]
  patients                    Patient[]
  clinicalHistoryEntries      ClinicalHistoryEntry[]
  clinicalHistoryAnnexEntries ClinicalHistoryAnnexEntry[]
  clinicalImages              ClinicalImage[]

  clinicalAccess           ClinicalAccess?
  clinicalAccessCodes      ClinicalAccessCode[]
  clinicalExternalSessions ClinicalExternalSession[]
}

model ClinicalAccess {
  id String @id @default(cuid())

  doctorId String  @unique
  active   Boolean @default(true)

  grantedAt    DateTime  @default(now())
  lastAccessAt DateTime?

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([active])
}

model ClinicalAccessCode {
  id       String @id @default(cuid())
  doctorId String

  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([expiresAt])
}

model ClinicalExternalSession {
  id       String @id @default(cuid())
  doctorId String

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt    DateTime @default(now())
  lastAccessAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([expiresAt])
}

model DoctorBranch {
  doctorId String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  @@id([doctorId, branchId])
}

model Plan {
  id          String @id @default(cuid())
  name        String
  description String

  benefits   String?
  conditions String?

  price    Decimal? @db.Decimal(12, 2)
  discount Decimal  @default(0) @db.Decimal(5, 2)

  visible Boolean @default(false)

  patients Patient[]
}

model HealthInsurance {
  id String @id @default(cuid())

  name String
  logo String?

  visible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible])
  @@index([name])
}

model Patient {
  id            String            @id @default(cuid())
  firstName     String
  lastName      String
  dni           String?
  phone         String
  email         String?
  birthDate     DateTime?
  branchId      String
  doctorId      String?
  planId        String?
  createdAt     DateTime          @default(now())
  userId        String?           @unique
  appointments  Appointment[]
  budgets       Budget[]
  histories     ClinicalHistory[]
  notifications Notification[]
  odontogram    Odontogram?
  branch        Branch            @relation(fields: [branchId], references: [id])
  doctor        Doctor?           @relation(fields: [doctorId], references: [id])
  plan          Plan?             @relation(fields: [planId], references: [id])
  user          User?             @relation(fields: [userId], references: [id])
  payments      Payment[]
  testimonial   Testimonial?
}

model Appointment {
  id           String            @id @default(cuid())
  date         DateTime
  status       AppointmentStatus @default(PENDING)
  notes        String?
  patientId    String
  doctorId     String
  branchId     String
  createdAt    DateTime          @default(now())
  reminderSent Boolean           @default(false)
  branch       Branch            @relation(fields: [branchId], references: [id])
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])

  @@index([doctorId, branchId, date])
  @@index([branchId, date])
  @@index([patientId, date])
  @@index([status])
}

model Budget {
  id               String   @id @default(cuid())
  total            Decimal
  description      String?
  patientId        String
  createdAt        DateTime @default(now())
  discount         Decimal  @default(0)
  subtotal         Decimal
  status           String   @default("CREATED")
  updatedAt        DateTime @default(now()) @updatedAt
  doctorSignature  String?
  patientSignature String?

  patient  Patient        @relation(fields: [patientId], references: [id])
  items    BudgetItem[]
  payments Payment[]
  doctors  BudgetDoctor[]

  @@index([patientId])
  @@index([status])
}

model BudgetDoctor {
  id       String @id @default(cuid())
  budgetId String
  doctorId String

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([budgetId, doctorId])
  @@index([budgetId])
  @@index([doctorId])
}

model ClinicalHistory {
  id        String   @id @default(cuid())
  diagnosis String?
  treatment String?
  patientId String
  createdAt DateTime @default(now())
  data      Json?
  updatedAt DateTime @updatedAt

  patient      Patient                     @relation(fields: [patientId], references: [id])
  entries      ClinicalHistoryEntry[]
  annexEntries ClinicalHistoryAnnexEntry[]
  images       ClinicalImage[]

  @@index([patientId])
}

model ClinicalHistoryEntry {
  id                String  @id @default(cuid())
  clinicalHistoryId String
  doctorId          String?

  professionalName    String
  professionalLicense String?

  diagnosis   String?
  treatment   String?
  evolution   String?
  indications String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicalHistory ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)
  doctor          Doctor?         @relation(fields: [doctorId], references: [id])

  @@index([clinicalHistoryId])
  @@index([doctorId])
  @@index([createdAt])
}

model SiteConfig {
  id                    Int      @id @default(1)
  heroTitle             String
  heroSubtitle          String
  whatsapp              String?
  instagram             String?
  facebook              String?
  updatedAt             DateTime @updatedAt
  clinicName            String
  heroImage             String?
  logo                  String?
  createdAt             DateTime @default(now())
  businessHoursSaturday String?
  businessHoursSunday   String?
  businessHoursWeek     String?
  googleReviewsUrl      String?
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String
  image       String?
  active      Boolean @default(true)
}

model GalleryImage {
  id       String  @id @default(cuid())
  imageUrl String
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
}

model BudgetItem {
  id          String @id @default(cuid())
  budgetId    String
  serviceName String
  quantity    Int    @default(1)
  unitPrice   Float
  total       Float
  budget      Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Odontogram {
  id        String   @id @default(cuid())
  patientId String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model OdontogramCondition {
  id        String   @id @default(cuid())
  name      String
  color     String
  createdAt DateTime @default(now())
}

model DoctorSchedule {
  id        String   @id @default(cuid())
  doctorId  String
  branchId  String
  weekday   Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday])
  @@index([branchId, weekday])
}

model DoctorScheduleException {
  id        String   @id @default(cuid())
  doctorId  String
  branchId  String
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([branchId, date])
}

model DoctorSpecificSchedule {
  id        String   @id @default(cuid())
  doctorId  String
  branchId  String
  date      DateTime @db.Date
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
  @@index([branchId, date])
}

model Expense {
  id        String   @id @default(cuid())
  concept   String
  category  String
  amount    Float
  date      DateTime
  branchId  String?
  createdAt DateTime @default(now())
  branch    Branch?  @relation(fields: [branchId], references: [id])
}

model Treatment {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  visible   Boolean  @default(true)
  patientId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approved  Boolean  @default(false)
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Notification {
  id                String            @id @default(cuid())
  patientId         String?
  title             String
  message           String
  type              NotificationType
  read              Boolean           @default(false)
  actionUrl         String?
  appointmentId     String?
  budgetId          String?
  paymentId         String?
  clinicalHistoryId String?
  createdAt         DateTime          @default(now())
  actor             NotificationActor @default(SYSTEM)
  doctorId          String?
  doctor            Doctor?           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient           Patient?          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, read])
  @@index([doctorId, read])
  @@index([createdAt])
}

model ClinicalHistoryAnnexEntry {
  id                String @id @default(cuid())
  clinicalHistoryId String

  createdByDoctorId String?

  professionalName String

  treatment   String
  indications String?

  debit   Decimal? @db.Decimal(12, 2)
  credit  Decimal? @db.Decimal(12, 2)
  balance Decimal? @db.Decimal(12, 2)

  nextAppointment  DateTime?
  patientSignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicalHistory ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id])
  createdByDoctor Doctor?         @relation(fields: [createdByDoctorId], references: [id])

  @@index([clinicalHistoryId])
  @@index([createdByDoctorId])
  @@index([createdAt])
}

model ClinicalImage {
  id                 String  @id @default(cuid())
  clinicalHistoryId  String
  uploadedByDoctorId String?

  type        ClinicalImageType
  title       String
  description String?
  imageUrl    String
  takenAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicalHistory  ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)
  uploadedByDoctor Doctor?         @relation(fields: [uploadedByDoctorId], references: [id])

  @@index([clinicalHistoryId])
  @@index([uploadedByDoctorId])
  @@index([type])
  @@index([createdAt])
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum NotificationType {
  APPOINTMENT
  BUDGET
  PAYMENT
  CLINICAL_HISTORY
}

enum NotificationActor {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
}

enum ClinicalImageType {
  RADIOGRAPH
  PHOTO
  OTHER
}
