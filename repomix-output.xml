}

function FeedbackMessage({
  type,
  message,
  onClose,
}: {
  type: "success" | "error";
  message: string;
  onClose: () => void;
}) {
  return (
    <div
      className={`flex items-start justify-between gap-4 border px-5 py-4 text-sm ${
        type === "success"
