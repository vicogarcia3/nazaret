    if (
      !entry.isOwn ||
      readOnly
    ) {
      return;
    }

    const confirmed =
      window.confirm(
        "¿Querés eliminar este registro del anexo?"
      );

    if (
      !confirmed
    ) {
      return;
    }

    try {
      setDeletingId(
        entry.id
      );

      const response =
        await fetch(
          `/api/clinical-history-annex/${entry.id}`,
          {
            method:
              "DELETE",
          }
        );

      const data =
        await response.json();

      if (
        !response.ok
      ) {
        toast.error(
          data.error ||
            "No se pudo eliminar el registro."
        );

        return;
      }

      if (
        activeRowId ===
        entry.id
      ) {
        cancelActiveRow();
      }

      toast.success(
        "Registro eliminado correctamente."
      );

      router.refresh();
    } catch (error) {
      console.error(
        "Error eliminando registro:",
        error
