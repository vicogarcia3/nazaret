                  {card.title}
                </h2>

                <p className="mt-2 max-w-md text-[13px] leading-5 text-[#6B7774]">
                  {card.description}
                </p>
              </Link>
            );
          })}
        </section>
      </div>
    </div>
  );
}
</file>

