  return (
    <main className="min-h-screen bg-[#F7F5EF] px-5 py-10 text-[#263F3B] md:px-8">
      <div className="mx-auto max-w-5xl">
        {/* CABECERA */}

        <header className="mb-8 border-b border-[#DED9CD] pb-7">
