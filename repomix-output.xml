      <h3 className="mt-1 text-xl font-semibold tracking-tight">{title}</h3>
      <p className="mt-1 text-xs leading-5 text-[#6B7774]">{description}</p>
      <div className="mt-5 space-y-5">{children}</div>
    </section>
