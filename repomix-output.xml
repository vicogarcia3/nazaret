  payments: Payment[];
};

type Props = {
  patientId: string;

  doctors: Doctor[];

  discountPercent: number;

  budgets: Budget[];

  branchName: string;
};

export default function BudgetManager({
  patientId,
  doctors,
  discountPercent,
  budgets,
  branchName,
}: Props) {
  const [
    editingBudget,
    setEditingBudget,
  ] = useState<EditableBudget | null>(
    null
  );

  function handleEditBudget(
    budget: EditableBudget
  ) {
    setEditingBudget(budget);
  }

  function handleCancelEdit() {
    setEditingBudget(null);
  }

  function handleSaved() {
    setEditingBudget(null);
  }

  return (
    <div className="space-y-10">
      <NewBudgetForm
        patientId={patientId}
        doctors={doctors}
        discountPercent={
          discountPercent
        }
        editingBudget={
          editingBudget
        }
        onCancelEdit={
          handleCancelEdit
        }
        onSaved={
          handleSaved
        }
      />

      <BudgetAccordion
        budgets={budgets}
        branchName={branchName}
        onEditBudget={
          handleEditBudget
        }
      />
    </div>
  );
}
</file>

