                {data.monthlyIncome.map(
                  (item) => {
                    const height =
                      item.income ===
                      0
                        ? 2
                        : Math.max(
                            (item.income /
                              maxChartValue) *
                              100,
                            6
                          );

                    const isSelected =
                      item.month ===
                      selectedMonth;

                    return (
                      <button
                        key={
                          item.month
                        }
                        type="button"
                        onClick={() =>
                          setSelectedMonth(
                            item.month
                          )
