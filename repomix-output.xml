                <div
                  className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-semibold ${
                    active || completed
                      ? "bg-[#6F855F] text-white"
                      : "bg-[#EEF0E8] text-[#6C7B72]"
