};

function generateSixDigitCode() {
  return Math.floor(
    100000 + Math.random() * 900000
  ).toString();
}

export async function POST(
  request: Request
) {
  try {
    const body =
      (await request.json()) as RequestCodeBody;

    const email =
      typeof body.email === "string"
        ? body.email.trim().toLowerCase()
        : "";

