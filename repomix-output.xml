                                : "bg-[#A2B38B] group-hover:bg-[#6F855F]"
                            }`}
                            style={{
                              height: `${height}%`,
                            }}
                          />
                        </div>

                        <span
                          className={`mt-3 text-xs font-semibold uppercase ${
                            isSelected
                              ? "text-[#263F3B]"
