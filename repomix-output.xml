    {
      label: "Pendientes",
      value: "PENDING",
    },
    {
      label: "Demorados",
      value: "OVERDUE",
    },
  ];

  function formatPhoneForWhatsApp(phone: string) {
    const cleanPhone = phone.replace(/\D/g, "");

