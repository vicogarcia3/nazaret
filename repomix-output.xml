                <div className="border-t border-[#7E8885]" />

                <p className="mt-2 text-[11px] font-medium text-[#263F3B]">
                  Firma y sello del profesional
                </p>

                <div className="mt-4 flex items-center gap-2 text-[10px] text-[#6B7774]">
