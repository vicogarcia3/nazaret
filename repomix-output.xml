};

type Patient = {
  id: string;
  firstName: string;
  lastName: string;
  dni: string | null;
  branchName: string;
  branchCity: string;

  history: {
    id: string;
    createdAt: string;
    updatedAt: string;
  } | null;
};

type Props = {
  doctor: Doctor;
  patients: Patient[];
};

export default function ExternalClinicalHistories({
